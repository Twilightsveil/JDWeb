{
  "name": "pinned-together",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler pages dev public",
    "deploy": "wrangler pages deploy public --project-name=pinned-together",
    "db:migrate:remote": "wrangler d1 execute pinned-together-db --remote --file=schema.sql",
    "db:migrate:local": "wrangler d1 execute pinned-together-db --local --file=schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.130.0"
  }
}
